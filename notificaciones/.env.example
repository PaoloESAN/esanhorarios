# Llaves VAPID para Web Push (generar con web-push, ver README raíz)
VAPID_PUBLIC_KEY=tu_public_key_aqui
VAPID_PRIVATE_KEY=tu_private_key_aqui
VAPID_SUBJECT=mailto:admin@esanhorarios.com

# URL del panel de la universidad donde se publican los .xlsx
TARGET_URL=https://tu-universidad.edu.pe/panel/horarios

# Cookie de sesión para autenticarse en TARGET_URL
SESSION_COOKIE=HWWAFSESID=...; HWWAFSESTIME=...; joomla_user_state=logged_in; uuid=id_sesion

# Opcional: ruta del JSON de persistencia (usa un Volume de Railway para sobrevivir deploys)
# DATA_FILE=/data/notificaciones.json
